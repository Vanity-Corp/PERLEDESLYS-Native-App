# Base URL for the PERLEDESLYS backend (perledeslys-backend, NestJS).
# Used by the auth client (src/lib/auth-api.ts → ${EXPO_PUBLIC_API_URL}/api/auth/*)
# and, historically, the AI-chat client (src/lib/api.ts → /api/ai-chat, a
# separate Cloudflare Worker that isn't deployed yet — see BACKEND_PLAN.md
# Phase 6; if both are needed at once, split this into two vars later).
#
# IMPORTANT: on a real device this must be the dev machine's LAN IP, NOT
# localhost/127.0.0.1 (the phone can't reach the computer's localhost).
# Find it with `ipconfig` (Windows) and use e.g. http://192.168.1.20:3000
# The backend listens on PORT 3000 by default.
EXPO_PUBLIC_API_URL=https://perledeslys-backend-production.up.railway.app
